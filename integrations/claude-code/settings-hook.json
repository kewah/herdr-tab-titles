{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|fork)$",
        "hooks": [{ "type": "command", "command": "{{claude-hook}} --lifecycle", "timeout": 15 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "{{claude-hook}} --lifecycle", "timeout": 15 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{claude-hook}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
