{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [{ "type": "command", "command": "{{launcher}} --source codex", "timeout": 15 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "{{launcher}} --source codex", "timeout": 3 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{launcher}} --source codex",
            "async": true,
            "timeout": 90
          }
        ]
      }
    ]
  }
}
